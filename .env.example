# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요 (cp .env.example .env)

# 로컬은 localhost. EC2 DB 를 쓰려면 ssh -N A505 로 터널을 열어 두거나,
# 컨테이너에서 직접 붙는다면 DB 호스트를 적는다.
POSTGRES_HOST=localhost
POSTGRES_DB=dotori_town
POSTGRES_USER=dotori
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# JWT 서명 키 (base64 인코딩, 256비트 이상). 생성 예: openssl rand -base64 48
JWT_SECRET=

# 이메일 인증 코드 발송용 SMTP (Gmail이면 앱 비밀번호 사용: 구글 계정 > 보안 > 앱 비밀번호)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 가상 금융망 연동 설정
FINANCE_BASE_URL=https://finopenapi.ssafy.io/ssafy/api/v1
FINANCE_API_KEY=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=