# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요 (cp .env.example .env)
#
# DB 접속 정보는 루트 ../.env 를 그대로 재사용하므로 여기에 다시 적지 않아도 됩니다.
# 여기에 적으면 루트 값을 덮어씁니다. (실제 환경변수가 있으면 그것이 항상 최우선)

# AI 서버 포트
AI_PORT=8000

# Spring -> AI 서버 내부 호출에 쓰는 공유 토큰. 양쪽에 같은 값을 넣습니다.
# 비어 있으면 토큰 검증을 건너뜁니다 (로컬 개발용). 배포 환경에서는 반드시 채웁니다.
# 생성 예: openssl rand -hex 32
INTERNAL_TOKEN=

# SSAFY GMS (OpenAI 호환 Chat Completions 게이트웨이). AI 서버 전용 값이라 여기에 둡니다.
# 루트 ../.env 는 Spring 과 공유하는 파일이므로 LLM 키를 넣지 않습니다.
# GMS_BASE 는 기본값이 있어 생략 가능하고, GMS_KEY 는 반드시 채워야 합니다.
GMS_KEY=
# GMS_BASE=https://gms.ssafy.io/gmsapi

# --- 루트 ../.env 값을 덮어쓸 때만 주석을 풉니다 ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=dotori_town
# POSTGRES_USER=dotori
# POSTGRES_PASSWORD=
