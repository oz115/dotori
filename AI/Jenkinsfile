// 도토리 AI 서버(FastAPI) CI/CD 파이프라인
//
// 흐름: 소스 변경 감지 -> 이미지 빌드 -> 테스트 -> ECR push -> 같은 EC2의 compose 갱신 -> 헬스체크
//
// --- Jenkins 등록 방법 ---
//   New Item > Pipeline > "Pipeline script from SCM"
//     SCM         : Git (https://lab.ssafy.com/s15-fintech-finance-sub1/S15P21A505.git)
//     Branch      : */dev
//     Script Path : AI/Jenkinsfile
//   Build Triggers : GitLab webhook (Push Events, dev 브랜치)
//
// --- 필요한 Jenkins Credentials ---
//   aws-ecr-credentials : ECR push/pull 용 IAM 키
//                         종류는 "Username with password"
//                         (Username = Access Key ID, Password = Secret Access Key)
//                         AWS Credentials 플러그인을 쓴다면 아래 withCredentials 블록을
//                         withAWS(credentials: 'aws-ecr-credentials', region: AWS_REGION) 으로 바꾼다.
//
// --- 사전 조건 ---
//   1. ECR 레포지토리가 있어야 한다 (1회)
//        aws ecr create-repository --repository-name dotori-ai --region ap-northeast-2
//   2. Ansible playbook을 한 번 돌려 /opt/dotori/docker-compose.yml 에 ai 서비스가 들어가 있어야 한다.
//      (이 파이프라인은 compose 파일을 만들지 않고, 이미 있는 ai 서비스의 이미지만 갱신한다)
//   3. jenkins 사용자가 docker 그룹에 속해 있어야 한다 (dotori-ansible playbook이 처리).

pipeline {
    agent any

    options {
        timestamps()
        // 배포가 겹치면 compose가 같은 컨테이너를 동시에 건드린다.
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 20, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'FORCE_BUILD',
            defaultValue: false,
            description: 'AI/ 변경이 없어도 강제로 빌드/배포합니다. 브랜치의 첫 빌드는 변경 내역이 비어 있어 자동 감지가 안 되므로 이때도 사용하세요.'
        )
    }

    environment {
        AWS_REGION    = 'ap-northeast-2'
        ECR_REPO_NAME = 'dotori-ai'
        // docker-compose.yml.j2 의 서비스 이름 / container_name 과 일치해야 한다.
        SERVICE        = 'ai'
        CONTAINER_NAME = 'dotori-ai'
        APP_DIR        = '/opt/dotori'
    }

    stages {
        // 백엔드와 한 저장소를 쓰므로, AI/ 가 바뀐 push 에만 반응한다.
        stage('AI 서버 빌드 및 배포') {
            when {
                beforeAgent true
                anyOf {
                    changeset 'AI/**'
                    expression { return params.FORCE_BUILD }
                }
            }

            stages {
                stage('준비') {
                    steps {
                        script {
                            // 커밋 해시를 불변 태그로 쓴다 (롤백은 이 태그로 한다).
                            env.IMAGE_TAG = sh(
                                script: 'git rev-parse --short HEAD',
                                returnStdout: true
                            ).trim()
                        }
                        echo "빌드 태그: ${env.IMAGE_TAG}"
                    }
                }

                stage('ECR 로그인') {
                    steps {
                        withCredentials([usernamePassword(
                            credentialsId: 'aws-ecr-credentials',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )]) {
                            script {
                                // 계정 ID를 소스에 박지 않는다 — 자격증명으로 조회한다.
                                env.AWS_ACCOUNT_ID = sh(
                                    script: 'aws sts get-caller-identity --query Account --output text',
                                    returnStdout: true
                                ).trim()
                                env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                                env.ECR_REPO     = "${env.ECR_REGISTRY}/${env.ECR_REPO_NAME}"
                            }
                            sh '''
                                set -e
                                aws ecr get-login-password --region "$AWS_REGION" \
                                    | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                            '''
                        }
                    }
                }

                stage('이미지 빌드') {
                    steps {
                        // 빌드 컨텍스트는 AI/ 다. Dockerfile 주석의 빌드 경로와 같다.
                        sh '''
                            set -e
                            docker build \
                                -t "$ECR_REPO:$IMAGE_TAG" \
                                -t "$ECR_REPO:latest" \
                                AI
                        '''
                    }
                }

                stage('테스트') {
                    steps {
                        // requirements.txt 에 pytest 가 있어 방금 만든 이미지로 그대로 돌린다.
                        // 테스트는 in-memory SQLite 와 mock 만 쓰므로 Postgres/GMS 가 필요 없다.
                        // 워크스페이스를 읽기 전용으로 붙이고 캐시를 끈다 — 컨테이너가 비-root(uid 1000)라
                        // .pytest_cache 를 쓰려 하면 실패한다.
                        sh '''
                            set -e
                            docker run --rm \
                                -v "$WORKSPACE/AI:/src:ro" \
                                -w /src \
                                -e PYTHONPATH=/src \
                                "$ECR_REPO:$IMAGE_TAG" \
                                pytest -q -p no:cacheprovider
                        '''
                    }
                }

                stage('ECR push') {
                    steps {
                        sh '''
                            set -e
                            docker push "$ECR_REPO:$IMAGE_TAG"
                            docker push "$ECR_REPO:latest"
                        '''
                    }
                }

                stage('배포') {
                    steps {
                        // Jenkins가 앱과 같은 EC2에 있으므로 SSH 없이 compose를 직접 조작한다.
                        // 서비스 이름을 명시해 postgres/redis/rabbitmq/app 은 건드리지 않는다.
                        // compose는 파일이 있는 디렉토리의 .env(AI_ECR_REPO/AI_IMAGE_TAG)를 자동으로 읽는다.
                        sh '''
                            set -e
                            cd "$APP_DIR"
                            docker compose pull "$SERVICE"
                            docker compose up -d "$SERVICE"
                        '''
                    }
                }

                stage('헬스체크') {
                    steps {
                        // Dockerfile 의 HEALTHCHECK 결과를 그대로 본다 (/health 폴링).
                        sh '''
                            set -e
                            i=1
                            while [ "$i" -le 40 ]; do
                                status=$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER_NAME" 2>/dev/null || echo starting)
                                echo "[$i/40] $CONTAINER_NAME health=$status"
                                if [ "$status" = "healthy" ]; then
                                    exit 0
                                fi
                                if [ "$status" = "unhealthy" ]; then
                                    break
                                fi
                                sleep 3
                                i=$((i + 1))
                            done
                            echo "AI 컨테이너가 healthy 가 되지 못했습니다. 최근 로그:"
                            docker logs --tail 50 "$CONTAINER_NAME" || true
                            exit 1
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "배포 완료: ${env.ECR_REPO_NAME}:${env.IMAGE_TAG ?: '(변경 없음 - 건너뜀)'}"
        }
        failure {
            echo '''배포 실패. 직전 버전으로 되돌리려면 EC2에서 다음을 실행하세요.
    cd /opt/dotori
    # 되돌릴 커밋 해시 태그를 확인
    aws ecr describe-images --repository-name dotori-ai --region ap-northeast-2 \\
        --query 'sort_by(imageDetails,&imagePushedAt)[-5:].imageTags'
    AI_IMAGE_TAG=<이전해시> docker compose up -d ai'''
        }
        always {
            // 이전 빌드의 dangling 이미지가 쌓이면 EC2 디스크를 먹는다.
            sh 'docker image prune -f >/dev/null 2>&1 || true'
            sh 'docker logout "$ECR_REGISTRY" >/dev/null 2>&1 || true'
        }
    }
}
