# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요 (cp .env.example .env)
#
# DB 접속 정보는 루트 ../.env 를 그대로 재사용하므로 여기에 다시 적지 않아도 됩니다.
# 여기에 적으면 루트 값을 덮어씁니다. (실제 환경변수가 있으면 그것이 항상 최우선)

# AI 서버 포트
AI_PORT=8000

# Spring -> AI 서버 내부 호출에 쓰는 공유 토큰. 양쪽에 같은 값을 넣습니다.
# 비어 있으면 토큰 검증을 건너뜁니다 (로컬 개발용). 배포 환경에서는 반드시 채웁니다.
# 생성 예: openssl rand -hex 32
INTERNAL_TOKEN=

# LLM 키는 여기에 넣지 않습니다. 루트 ../.env 의 GMS_KEY / GMS_BASE 를 그대로 씁니다.
#   GMS_KEY   SSAFY GMS 발급 키
#   GMS_BASE  https://gms.ssafy.io/gmsapi  (코드가 /api.openai.com/v1 을 붙입니다)
# 개인 키로 갈아끼울 때만 아래 주석을 풀어 루트 값을 덮어씁니다.
# GMS_KEY=
# GMS_BASE=https://gms.ssafy.io/gmsapi

# 사용할 모델. GMS 가 중계하는 이름을 그대로 씁니다.
# ../AI-docs 의 실험 노트북도 같은 두 값을 읽습니다.
OPENAI_MODEL=gpt-4o-mini

# app.* 로거 레벨. 상점 근거(reason)와 LLM 호출 이력을 로그로만 남기므로 INFO 가 기본입니다.
# 라이브러리 로그가 시끄러우면 WARNING 으로 올립니다.
# LOG_LEVEL=INFO

# --- RabbitMQ: 루트 ../.env 의 RABBITMQ_* 를 그대로 씁니다 ---
# 로컬 브로커는 docker-compose.local.yml 의 rabbitmq (기본 guest/guest).
# 빈 문자열은 guest 로 취급합니다 — pydantic 은 변수가 *없을* 때만 기본값을 쓰므로
# `RABBITMQ_USERNAME=` 처럼 비워 두면 그 빈 값이 그대로 들어가 AMQP 403 이 납니다.
# STORE_PRICING_CONSUMER_ENABLED=true   # false 면 큐를 구독하지 않습니다

# --- 루트 ../.env 값을 덮어쓸 때만 주석을 풉니다 ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=dotori_town
# POSTGRES_USER=dotori
# POSTGRES_PASSWORD=
