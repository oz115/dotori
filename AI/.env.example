# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요 (cp .env.example .env)
#
# AI 서버는 나중에 독립 프로세스/컨테이너로 뜬다. 그래서 Spring 과 같은 값이라도
# 여기에 자체적으로 다 둔다 — 루트 ../.env 에 기대지 않는다.
# (config 는 ../.env 를 먼저 읽고 이 .env 가 덮으므로, 모노레포로 함께 돌릴 때도 동작한다.)

# AI 서버 포트
AI_PORT=8000

# Spring -> AI 서버 내부 호출에 쓰는 공유 토큰. 양쪽에 같은 값을 넣습니다.
# 비어 있으면 토큰 검증을 건너뜁니다 (로컬 개발용). 배포 환경에서는 반드시 채웁니다.
# 생성 예: openssl rand -hex 32
INTERNAL_TOKEN=

# --- LLM (SSAFY GMS, OpenAI 호환 게이트웨이) ---
# AI 서버만 GMS 를 호출한다 (Spring 은 안 쓴다). 그래서 이 키는 AI 서버 전용이다.
GMS_KEY=
GMS_BASE=https://gms.ssafy.io/gmsapi
# GMS 가 중계하는 모델 이름을 그대로 씁니다.
# ../AI-docs 의 실험 노트북도 같은 값들을 읽습니다.
OPENAI_MODEL=gpt-4o-mini
# 금융 퀴즈는 이야기 구성과 출력 규칙 준수를 위해 별도 모델을 사용합니다.
QUIZ_OPENAI_MODEL=gpt-5.4-mini

# app.* 로거 레벨. 상점 근거(reason)와 LLM 호출 이력을 로그로만 남기므로 INFO 가 기본입니다.
# LOG_LEVEL=INFO

# --- DB (Spring 과 같은 Postgres) ---
# 로컬은 ssh -N A505 터널로 EC2 DB 를 localhost:5432 에 연다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dotori_town
POSTGRES_USER=dotori
POSTGRES_PASSWORD=

# --- RabbitMQ (Spring 과 같은 브로커) ---
# 로컬 브로커는 docker-compose.local.yml 의 rabbitmq (기본 guest/guest).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# 아래 둘은 거의 안 바꾼다. 기본값이 있어 비워 둬도 된다.
# RABBITMQ_VHOST=/
# RABBITMQ_HEARTBEAT=180
# false 면 큐를 구독하지 않습니다 (공유 큐를 로컬에서 가로채고 싶지 않을 때).
# STORE_PRICING_CONSUMER_ENABLED=true
