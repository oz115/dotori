# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요 (cp .env.example .env)

# ── DB 두 개를 역할로 나눠 쓴다 ────────────────────────────────
#   공용 EC2 DB : QA 전용. 데이터를 쌓아 두고 실제 기능을 확인하는 곳.
#                 앱(bootRun)이 여기 붙는다. 아래 POSTGRES_* 가 그 설정이다.
#   로컬 도커 DB: 테스트 전용. 각자 것이라 남과 충돌하지 않는다.
#                 ./gradlew test 가 자동으로 localhost:5433 을 쓴다.
#                 설정이 필요 없으므로 여기 적을 것도 없다.
#
#   테스트가 공용 DB 를 건드리지 않게 아예 경로를 끊어 뒀다.
#   (backend/src/test/resources/application.yaml 은 .env 를 읽지 않는다)
# ───────────────────────────────────────────────────────────────

# 앱이 붙을 DB. 공용 EC2 를 쓰려면 ssh -N A505 로 터널을 먼저 연다.
POSTGRES_HOST=localhost
POSTGRES_DB=dotori_town
POSTGRES_USER=dotori
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 로컬 도커 postgres 를 호스트에 노출할 포트. 기본 5433.
# 5432 는 위 ssh 터널이 쓰므로 겹치지 않게 갈라 두었다. 보통 건드릴 일이 없다.
# LOCAL_POSTGRES_PORT=5433

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# JWT 서명 키 (base64 인코딩, 256비트 이상). 생성 예: openssl rand -base64 48
JWT_SECRET=

# 이메일 인증 코드 발송용 SMTP (Gmail이면 앱 비밀번호 사용: 구글 계정 > 보안 > 앱 비밀번호)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 가상 금융망 연동 설정
FINANCE_BASE_URL=https://finopenapi.ssafy.io/ssafy/api/v1
FINANCE_API_KEY=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=