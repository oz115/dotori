# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요 (cp .env.example .env)

# 로컬은 localhost. EC2 DB 를 쓰려면 ssh -N A505 로 터널을 열어 두거나,
# 컨테이너에서 직접 붙는다면 DB 호스트를 적는다.
POSTGRES_HOST=localhost
POSTGRES_DB=dotori_town
POSTGRES_USER=dotori
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# JWT 서명 키 (base64 인코딩, 256비트 이상). 생성 예: openssl rand -base64 48
JWT_SECRET=

# 이메일 인증 코드 발송용 SMTP (Gmail이면 앱 비밀번호 사용: 구글 계정 > 보안 > 앱 비밀번호)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 가상 금융망 연동 설정
FINANCE_BASE_URL=https://finopenapi.ssafy.io/ssafy/api/v1
FINANCE_API_KEY=

# AI 서버(FastAPI) 내부 호출 — 투자 뉴스 생성·가격 반영 트리거
# INTERNAL_TOKEN 은 AI/.env 의 INTERNAL_TOKEN 과 같은 값 (로컬은 비워 두면 검증 생략)
AI_BASE_URL=http://localhost:8000
INTERNAL_TOKEN=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# FCM 푸시 발송용 Firebase 서비스 계정 키 경로 (backend/ 기준 상대경로 또는 절대경로)
# 발급: Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 파일 자체는 절대 커밋하지 않는다 (backend/.gitignore 의 *firebase-adminsdk*.json 패턴 참고)
# 비워 두면 firebaseMessaging 빈 생성이 실패해 앱이 아예 기동하지 않는다
FCM_CREDENTIALS_PATH=

# AWS 엑세스 토큰
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 인증 사진 저장 버킷 (팀 공용, 비공개). 버킷 이름은 비밀이 아니라 주소일 뿐이고,
# 위 자격증명 없이는 접근할 수 없다
AWS_S3_BUCKET=s15p21a505dotori
